# MAJOR: Copy this file to ".env" (same folder) and fill in the values. Never share the .env file.

# --- Supabase (lets the service check that a request comes from a logged-in user) ---
# Leave both empty to run in DEMO mode (no login check).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Resend (emails) ---
RESEND_API_KEY=
RESEND_FROM=PIGEM <onboarding@resend.dev>

# --- Ollama (local AI) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# --- Google reCAPTCHA v2 ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Website addresses allowed to call this service (comma separated) ---
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
